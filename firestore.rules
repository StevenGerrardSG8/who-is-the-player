rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboards are public read; a client can only ever write its own
    // anonymous-auth identity's doc/run, never impersonate another uid.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /runs/{runId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Bug reports: any signed-in device (incl. anonymous) can file one under
    // its own uid, but only the developer account can read them back — this
    // is the only genuinely private collection in the app.
    match /bugReports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow get, list: if request.auth != null && request.auth.token.email == "amit.p@xpendmarketing.com";
      allow update, delete: if false;
    }

    // Aggregate counters (games played, unique visitors) — every device can
    // bump them by exactly one of the two known fields, but only the
    // developer account can read the totals back.
    match /stats/summary {
      allow get: if request.auth != null && request.auth.token.email == "amit.p@xpendmarketing.com";
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['gamesPlayed', 'uniqueVisitors']);
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gamesPlayed', 'uniqueVisitors']);
      allow delete: if false;
    }
  }
}
